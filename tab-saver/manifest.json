{
  "manifest_version": 3,

  "name": "AI Tab Manager",

  "version": "1.0",

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "icons": {
  "128": "icon.png"
  }

}